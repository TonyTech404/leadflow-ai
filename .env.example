# Copy to .env for local development (npm run dev) and migrations (npm run db:migrate).

# Postgres. Neon works as is (the channel_binding parameter is stripped automatically).
DATABASE_URL=postgres://leadflow:leadflow@localhost:5432/leadflow

# Optional: a separate database for the integration tests (npm test). Tests are skipped without it.
# The tests read DATABASE_URL, so run them as: DATABASE_URL=$TEST_DATABASE_URL npm test
TEST_DATABASE_URL=

# Optional. Without a key, qualification and drafts use the deterministic demo rules,
# which the app labels "Demo rules, no AI call".
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5
# AI calls per day across all visitors before falling back to the demo rules.
DAILY_AI_LIMIT=2000

# Protects POST /api/cron (sync retries, "no reply" automations, housekeeping).
CRON_SECRET=change-me
# Signs the simulated inbound GoHighLevel webhooks.
WEBHOOK_SECRET=change-me
